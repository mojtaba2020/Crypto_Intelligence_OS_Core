{
  "$defs": {
    "ProducerRef": {
      "additionalProperties": false,
      "description": "Identifies the component that produced a message.",
      "properties": {
        "component_id": {
          "maxLength": 128,
          "minLength": 2,
          "title": "Component Id",
          "type": "string"
        },
        "component_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Component Version",
          "type": "string"
        }
      },
      "required": [
        "component_id",
        "component_version"
      ],
      "title": "ProducerRef",
      "type": "object"
    },
    "SecurityContext": {
      "additionalProperties": false,
      "description": "Non-authoritative security metadata carried with a message.\n\nReceiving services MUST validate authorization against an authoritative policy service;\nthese fields never grant privileges by themselves.",
      "properties": {
        "actor_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actor Id"
        },
        "actor_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actor Type"
        },
        "approval_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval Id"
        },
        "data_classification": {
          "default": "INTERNAL",
          "title": "Data Classification",
          "type": "string"
        }
      },
      "title": "SecurityContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Concrete envelope used for schema export and generic structured payloads.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "message_id": {
      "title": "Message Id",
      "type": "string"
    },
    "message_type": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Message Type",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "producer": {
      "$ref": "#/$defs/ProducerRef"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "security_context": {
      "$ref": "#/$defs/SecurityContext"
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Id"
    },
    "trace_id": {
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "message_type",
    "trace_id",
    "producer",
    "payload"
  ],
  "title": "DictEnvelope",
  "type": "object"
}
