{
  "$defs": {
    "ErrorCategory": {
      "enum": [
        "VALIDATION_ERROR",
        "AUTHENTICATION_ERROR",
        "AUTHORIZATION_ERROR",
        "DATA_ERROR",
        "MODEL_ERROR",
        "AGENT_ERROR",
        "TOOL_ERROR",
        "ROUTING_ERROR",
        "MEMORY_ERROR",
        "RESEARCH_ERROR",
        "RISK_ERROR",
        "SECURITY_ERROR",
        "TIMEOUT",
        "RATE_LIMIT",
        "CONFLICT",
        "DEPENDENCY_ERROR",
        "INTERNAL_ERROR",
        "UNKNOWN_ERROR"
      ],
      "title": "ErrorCategory",
      "type": "string"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/ErrorCategory"
        },
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "component_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Component Id"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "error_id": {
          "title": "Error Id",
          "type": "string"
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fingerprint"
        },
        "message": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "severity": {
          "$ref": "#/$defs/ErrorSeverity",
          "default": "MEDIUM"
        }
      },
      "required": [
        "code",
        "category",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "ErrorSeverity": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "ErrorSeverity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "error": {
      "$ref": "#/$defs/ErrorDetail"
    },
    "trace_id": {
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "trace_id",
    "error"
  ],
  "title": "ErrorEnvelope",
  "type": "object"
}
